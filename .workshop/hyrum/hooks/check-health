# Workshop creates the cache mount owned by the workshop user (uid/gid on the
# plug don't survive the container's id mapping), but the checks run as
# `hyrum-check`, so hand it over here -- this is the last hook to run as root
# before the SDK is marked ready.
chown -R hyrum-check:hyrum-check /home/hyrum-check/.cache/hyrum

if sudo -u hyrum-check test -w /home/hyrum-check/.cache/hyrum; then
    workshopctl set-health okay
else
    workshopctl set-health error
fi
